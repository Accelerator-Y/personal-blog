---
import { SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' },
  { href: '/links/', label: '友链' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <nav>
      {
        navItems.map((item) => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgba(253, 253, 251, 0.9);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }

  .site-title:hover {
    text-decoration: none;
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: var(--text-muted);
    font-size: 0.95rem;
    padding-bottom: 2px;
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  nav a.active {
    color: var(--accent);
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }

  @media (max-width: 480px) {
    nav {
      gap: 0.8rem;
    }
  }
</style>
