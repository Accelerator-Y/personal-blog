---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { AUTHOR, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <h1>你好，我是 {AUTHOR} 👋</h1>
    <p class="muted">{SITE_DESCRIPTION}</p>
  </section>

  <section>
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog/">全部文章 →</a>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <span class="post-title">{post.data.title}</span>
            </a>
            <div class="muted">
              <FormattedDate date={post.data.pubDate} /> · {post.data.description}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }

    .hero h1 {
      margin: 0 0 0.5rem;
      font-size: 1.9rem;
    }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-top: 1.5rem;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1.3rem;
    }

    .section-head a {
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
